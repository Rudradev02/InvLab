# InvLab environment variables
# Copy to .env and edit. Never commit the real .env file.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
TIME_ZONE=Asia/Kolkata

# --- Database ---
# Leave empty to use local SQLite. For PostgreSQL / Neon use sslmode=require.
DATABASE_URL=
# Example: postgresql://user:password@host:5432/invlab?sslmode=require

# --- Production security (set when DJANGO_DEBUG=0) ---
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_AGE=43200
SESSION_INACTIVITY_TIMEOUT=7200

# --- Rate limits ---
THROTTLE_LOGIN=5/min
THROTTLE_WRITE=60/min
THROTTLE_DEFAULT=300/min

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend (Vite) ---
VITE_API_BASE=/api/v1

# --- Email (v1.2) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=InvLab <no-reply@example.com>

# --- Media storage for product images (v1.2) ---
# MEDIA_STORAGE=local      # local | s3 | cloudinary
# CLOUDINARY_URL=
# AWS_STORAGE_BUCKET_NAME=
